# Copie este archivo a .env.local y ponga valores de un proyecto Firebase SOLO de desarrollo.
# Valores falsos: nunca suba valores reales a Git. Producción vive solo en Vercel.

# Públicas (configuración web de Firebase: identifica el proyecto, no da acceso a datos)
NEXT_PUBLIC_FIREBASE_API_KEY=falso-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mi-proyecto-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mi-proyecto-dev
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:falso

# Ciudad configurada (límites para validar lat/lng): Medellín por defecto
NEXT_PUBLIC_CIUDAD_NOMBRE=Medellín
NEXT_PUBLIC_CIUDAD_LIMITES=6.13,6.37,-75.70,-75.47

# Solo servidor
FIREBASE_PROJECT_ID=mi-proyecto-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-falso@mi-proyecto-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nFALSA\n-----END PRIVATE KEY-----\n"
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_falso

# Prueba de contención (sección 9): ponga esta línea en un .env.local de prueba
# CANARIO=ZZZ-NO-ES-UN-SECRETO
